# ==========================================
# ATEEVIBES COMMERCE PLATFORM - ENVIRONMENT
# ==========================================

# Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://ateevibes:ateevibes_dev_pass_2026@localhost:5432/ateevibes_commerce?schema=public"

# Application Configuration
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,https://clothing-rose-three.vercel.app"

# JWT Authentication
JWT_SECRET="ateevibes_jwt_super_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="ateevibes_jwt_refresh_super_secret_key_change_in_production_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Razorpay Sandbox / Production (Optional for local testing)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Storage (Local or S3/Supabase)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Transactional Email (Mock / SMTP / Resend)
EMAIL_PROVIDER="mock"
EMAIL_FROM="concierge@ateevibes.com"

# Store Policies
FREE_SHIPPING_THRESHOLD=1499
STANDARD_SHIPPING_FEE=79
COD_FEE=49
RESERVATION_EXPIRY_MINUTES=15
